{
  "name": "skeleton-key",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:scopecheck": "npm run dev -w @skeleton-key/scopecheck",
    "dev:packcheck": "npm run dev -w @skeleton-key/packcheck",
    "build:scopecheck": "npm run build -w @skeleton-key/scopecheck",
    "build:packcheck": "npm run build -w @skeleton-key/packcheck",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "a11y": "npx tsx tools/a11y/check.ts",
    "docs:sync": "tsx tools/docs/sync-from-specs.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "undici": "7.30.1",
    "sharp": "0.35.5"
  }
}
